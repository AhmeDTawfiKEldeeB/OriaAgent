# Active LLM Provider: "gemini" or "groq"
LLM_PROVIDER=gemini

# Active Memory / Vector DB Provider: "qdrant" or "mongodb"
MEMORY_PROVIDER=qdrant

# Application Environment
APP_ENV=development

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.7

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.7

# Qdrant Vector Database Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_if_applicable
QDRANT_COLLECTION_NAME=long_term_memory
EMBEDDING_MODEL=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.9

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=oria_agent
MONGODB_COLLECTION_NAME=long_term_memory
MONGODB_EMBEDDING_MODEL=all-MiniLM-L6-v2
MONGODB_SIMILARITY_THRESHOLD=0.9

# ElevenLabs / Text-To-Speech Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# Image-To-Text (Vision) Configuration (e.g., llama-3.2-11b-vision-preview)
ITT_MODEL_NAME=llama-3.2-11b-vision-preview

# Cloudflare & Text-To-Image Configuration
TTI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
TTI_MODEL_NAME=@cf/black-forest-labs/flux-1-schnell
TEXT_MODEL_NAME=llama-3.3-70b-versatile


